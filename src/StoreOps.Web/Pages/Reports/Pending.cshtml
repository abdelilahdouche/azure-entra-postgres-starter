@page
@model StoreOps.Web.Pages.Reports.PendingModel
@{
    ViewData["Title"] = "Approvals";
}

<h1>Reports waiting for approval</h1>
<p class="muted">Only users with the <code>@AppRoles.Manager</code> or <code>@AppRoles.Admin</code> role can see this page.</p>

@if (Model.Reports.Count == 0)
{
    <p class="muted">Nothing to approve. 🎉</p>
}
else
{
    <table>
        <thead><tr><th>Store</th><th>Title</th><th>Uploaded</th><th></th></tr></thead>
        <tbody>
        @foreach (var r in Model.Reports)
        {
            <tr>
                <td>@r.StoreCode</td>
                <td><a asp-page="/Reports/Download" asp-route-id="@r.Id">@r.Title</a></td>
                <td>@r.UploadedAt.ToString("yyyy-MM-dd HH:mm") · @r.UploadedBy</td>
                <td>
                    <form method="post" asp-page-handler="Approve" asp-route-id="@r.Id">
                        <button type="submit">Approve</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
}
